<?xml version="1.0" encoding="UTF-8"?>
<!-- Simpler companion mapping — a passthrough with one normalization rule,
     used by WF_LOAD_ACCOUNTS_workflow.xml's first session. -->
<POWERMART>
  <REPOSITORY NAME="BANK_DATAHUB_REPO">
    <FOLDER NAME="DATAHUB_ETL">
      <MAPPING NAME="M_LOAD_CUSTOMERS" DESCRIPTION="Loads the DataHub customers mart from the core banking extract.">

        <TRANSFORMATION NAME="SQ_CUSTOMERS_SRC" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="FULL_NAME"   DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="EMAIL_RAW"   DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION=""/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="EXP_NORMALIZE_EMAIL" TYPE="Expression">
          <TRANSFORMFIELD NAME="IN_CUSTOMER_ID" DATATYPE="string" PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="IN_FULL_NAME"   DATATYPE="string" PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="IN_EMAIL_RAW"   DATATYPE="string" PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="OUT_CUSTOMER_ID" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="IN_CUSTOMER_ID"/>
          <TRANSFORMFIELD NAME="OUT_FULL_NAME"   DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="IN_FULL_NAME"/>
          <TRANSFORMFIELD NAME="OUT_EMAIL"       DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="LOWER(LTRIM(RTRIM(IN_EMAIL_RAW)))"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="CUSTOMERS_TGT" TYPE="Target Definition">
          <TRANSFORMFIELD NAME="customer_id" DATATYPE="string" PORTTYPE="INPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="full_name"   DATATYPE="string" PORTTYPE="INPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="email"       DATATYPE="string" PORTTYPE="INPUT" EXPRESSION=""/>
        </TRANSFORMATION>

        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS_SRC" FROMFIELD="CUSTOMER_ID" TOINSTANCE="EXP_NORMALIZE_EMAIL" TOFIELD="IN_CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS_SRC" FROMFIELD="FULL_NAME"   TOINSTANCE="EXP_NORMALIZE_EMAIL" TOFIELD="IN_FULL_NAME"/>
        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS_SRC" FROMFIELD="EMAIL_RAW"   TOINSTANCE="EXP_NORMALIZE_EMAIL" TOFIELD="IN_EMAIL_RAW"/>

        <CONNECTOR FROMINSTANCE="EXP_NORMALIZE_EMAIL" FROMFIELD="OUT_CUSTOMER_ID" TOINSTANCE="CUSTOMERS_TGT" TOFIELD="customer_id"/>
        <CONNECTOR FROMINSTANCE="EXP_NORMALIZE_EMAIL" FROMFIELD="OUT_FULL_NAME"   TOINSTANCE="CUSTOMERS_TGT" TOFIELD="full_name"/>
        <CONNECTOR FROMINSTANCE="EXP_NORMALIZE_EMAIL" FROMFIELD="OUT_EMAIL"       TOINSTANCE="CUSTOMERS_TGT" TOFIELD="email"/>

      </MAPPING>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
