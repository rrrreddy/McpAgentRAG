<?xml version="1.0" encoding="UTF-8"?>
<!--
  Illustrative PowerCenter mapping export in the shape app.informatica.parser
  expects: a <MAPPING> containing <TRANSFORMATION> instances (each with
  <TRANSFORMFIELD> ports) and <CONNECTOR> edges wiring ports between
  instances by name. This is hand-authored to be representative of a real
  Repository Manager / pmrep XML export, trimmed to the elements the parser
  actually reads.

  Field-level lineage this encodes (see docs for the traced chain):
    SQ_ACCOUNTS_SRC.RAW_BALANCE
      -> EXP_CALC_BALANCE.IN_RAW_BALANCE
      -> EXP_CALC_BALANCE.OUT_BALANCE   (expression: ROUND(IN_RAW_BALANCE, 2))
      -> ACCOUNTS_TGT.account_balance
-->
<POWERMART>
  <REPOSITORY NAME="BANK_DATAHUB_REPO">
    <FOLDER NAME="DATAHUB_ETL">
      <MAPPING NAME="M_LOAD_ACCOUNTS" DESCRIPTION="Loads the DataHub accounts mart from the core banking extract.">

        <TRANSFORMATION NAME="SQ_ACCOUNTS_SRC" TYPE="Source Qualifier">
          <TRANSFORMFIELD NAME="ACCOUNT_ID"   DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="CUSTOMER_ID"  DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="RAW_BALANCE"  DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="REGION"       DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION=""/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="EXP_CALC_BALANCE" TYPE="Expression">
          <TRANSFORMFIELD NAME="IN_ACCOUNT_ID"  DATATYPE="string"  PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="IN_CUSTOMER_ID" DATATYPE="string"  PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="IN_RAW_BALANCE" DATATYPE="decimal" PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="IN_REGION"      DATATYPE="string"  PORTTYPE="INPUT"  EXPRESSION=""/>
          <TRANSFORMFIELD NAME="OUT_ACCOUNT_ID"  DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION="IN_ACCOUNT_ID"/>
          <TRANSFORMFIELD NAME="OUT_CUSTOMER_ID" DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION="IN_CUSTOMER_ID"/>
          <TRANSFORMFIELD NAME="OUT_BALANCE"     DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="ROUND(IN_RAW_BALANCE, 2)"/>
          <TRANSFORMFIELD NAME="OUT_REGION"      DATATYPE="string"  PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(IN_REGION), 'UNKNOWN', UPPER(IN_REGION))"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="ACCOUNTS_TGT" TYPE="Target Definition">
          <TRANSFORMFIELD NAME="account_id"      DATATYPE="string"  PORTTYPE="INPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="customer_id"     DATATYPE="string"  PORTTYPE="INPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="account_balance" DATATYPE="decimal" PORTTYPE="INPUT" EXPRESSION=""/>
          <TRANSFORMFIELD NAME="region"          DATATYPE="string"  PORTTYPE="INPUT" EXPRESSION=""/>
        </TRANSFORMATION>

        <CONNECTOR FROMINSTANCE="SQ_ACCOUNTS_SRC" FROMFIELD="ACCOUNT_ID"  TOINSTANCE="EXP_CALC_BALANCE" TOFIELD="IN_ACCOUNT_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_ACCOUNTS_SRC" FROMFIELD="CUSTOMER_ID" TOINSTANCE="EXP_CALC_BALANCE" TOFIELD="IN_CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_ACCOUNTS_SRC" FROMFIELD="RAW_BALANCE" TOINSTANCE="EXP_CALC_BALANCE" TOFIELD="IN_RAW_BALANCE"/>
        <CONNECTOR FROMINSTANCE="SQ_ACCOUNTS_SRC" FROMFIELD="REGION"      TOINSTANCE="EXP_CALC_BALANCE" TOFIELD="IN_REGION"/>

        <CONNECTOR FROMINSTANCE="EXP_CALC_BALANCE" FROMFIELD="OUT_ACCOUNT_ID"  TOINSTANCE="ACCOUNTS_TGT" TOFIELD="account_id"/>
        <CONNECTOR FROMINSTANCE="EXP_CALC_BALANCE" FROMFIELD="OUT_CUSTOMER_ID" TOINSTANCE="ACCOUNTS_TGT" TOFIELD="customer_id"/>
        <CONNECTOR FROMINSTANCE="EXP_CALC_BALANCE" FROMFIELD="OUT_BALANCE"     TOINSTANCE="ACCOUNTS_TGT" TOFIELD="account_balance"/>
        <CONNECTOR FROMINSTANCE="EXP_CALC_BALANCE" FROMFIELD="OUT_REGION"      TOINSTANCE="ACCOUNTS_TGT" TOFIELD="region"/>

      </MAPPING>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
