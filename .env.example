# ---------------------------------------------------------------------------
# Enterprise RAG + MCP Agents — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core app ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173

# --- Auth / JWT --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Postgres (app data + pgvector) -----------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragmcp

# Bootstrap superuser used ONLY by the official postgres image to init the
# cluster and run sample_data/db_init/*.sh. The application NEVER connects
# as this user — see sample_data/db_init/README.md for why that matters
# (a superuser-owned view silently bypasses Row-Level Security for everyone).
POSTGRES_SUPERUSER_PASSWORD=change-me-bootstrap-password

# Application identity (read-write): owns the app schema + the datahub
# schema's tables/views, but is a plain LOGIN role, not a superuser, so
# Postgres RLS actually applies when db-mcp's readonly role queries through it.
POSTGRES_USER=ragmcp_app
POSTGRES_PASSWORD=change-me-app-password

# Dedicated READ-ONLY role used exclusively by db-mcp against masked views in
# the "datahub" schema — never granted access to base tables. In real Oracle
# deployments this maps to a role with SELECT-only grants plus Virtual
# Private Database (VPD) / Data Redaction policies applied server-side —
# see docs/oracle_datahub_security.md
POSTGRES_READONLY_USER=ragmcp_readonly
POSTGRES_READONLY_PASSWORD=change-me-readonly-password

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_READONLY=postgresql+asyncpg://${POSTGRES_READONLY_USER}:${POSTGRES_READONLY_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis (session cache, rate limiting, short-term agent memory) ---------
REDIS_URL=redis://redis:6379/0

# --- Vector stores -----------------------------------------------------------
# "pgvector" (default, recommended for production) or "chroma"
VECTOR_STORE_BACKEND=pgvector
CHROMA_HOST=chroma
CHROMA_PORT=8001
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Model gateway ------------------------------------------------------------
# Provider used by default for agent reasoning/synthesis: anthropic | openai | ollama
MODEL_GATEWAY_PRIMARY_PROVIDER=anthropic
MODEL_GATEWAY_FALLBACK_PROVIDER=ollama

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Per-team/day token budget enforced by the gateway (0 = unlimited)
MODEL_GATEWAY_DAILY_TOKEN_BUDGET=2000000

# --- MCP servers (streamable-http endpoints) ---------------------------------
KNOWLEDGE_MCP_URL=http://knowledge-mcp:9101/mcp
DB_MCP_URL=http://db-mcp:9102/mcp
LINEAGE_MCP_URL=http://lineage-mcp:9103/mcp
GOVERNANCE_MCP_URL=http://governance-mcp:9104/mcp
MCP_SHARED_SECRET=change-me-mcp-service-secret

# --- Audit --------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=365
